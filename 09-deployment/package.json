    "post:02": "tsx 02-timeouts-that-abort/example.ts",
    "post:03": "tsx 03-load-shedding/example.ts",
    "post:04": "tsx 04-health-and-readiness/example.ts",
    "post:05": "tsx 05-graceful-shutdown/example.ts",
    "post:06": "tsx 06-the-rag-service/example.ts",
    "post:07": "tsx 07-container-image/example.ts",
    "post:08": "tsx 08-kubernetes/example.ts",
    "post:09": "tsx 09-ci-eval-gate/example.ts",
