# Copy to .env (repo root). Every example reads models from here; nothing is hard-coded.

# --- Provider ---------------------------------------------------------------
# ollama (default) | azure | bedrock | openai-compatible   (see 08-cloud)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Models (any Ollama model names from `ollama list`) -----------------------
# Chat model: should support tool calling (check the model's page on ollama.com).
CHAT_MODEL=<your-chat-model>
# Embedding model used by RAG (04), evals (05), observability (07) and the RAG service (09).
# The capstone does not embed.
EMBED_MODEL=<your-embedding-model>
# Optional: second chat model for the fallback chain (06) and the gateway `fast` alias (08).
FALLBACK_MODEL=
# Optional: model used as the LLM judge in evals (defaults to CHAT_MODEL).
JUDGE_MODEL=
# Pass rate below this fails `npm run evals` (05 default 0.6, capstone default 0.7).
EVAL_THRESHOLD=0.6

# --- RAG reranking (04) ---------------------------------------------------------
# none | llm  (llm = ask CHAT_MODEL to score each candidate chunk; works with any model)
RERANKER=llm

# --- Observability (07) ---------------------------------------------------------
# 07-observability: console (default) | console-raw | otlp (-> OTEL_EXPORTER_OTLP_ENDPOINT: Jaeger, Collector...) | langfuse | memory
TRACE_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional Langfuse (cloud or self-hosted) — used when TRACE_EXPORTER=langfuse.
# Spans only. Prompt versions and scores are not wired.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Record prompts and completions on spans. Leave unset for anything that might contain PHI.
OTEL_CAPTURE_CONTENT=false
# USD per 1M tokens, from your provider's price sheet. Unset → app.cost_usd is 0.
PRICE_PER_MTOK_IN=0
PRICE_PER_MTOK_OUT=0

# --- RAG service (09) -----------------------------------------------------------
PORT=8080
# RAG_DB_PATH=09-deployment/data/rag.db
MAX_CONCURRENT=4
REQUEST_TIMEOUT_MS=60000

# --- Cloud providers (08) — only needed when AI_PROVIDER is switched -------------
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
