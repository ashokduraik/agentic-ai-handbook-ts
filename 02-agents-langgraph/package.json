{
  "name": "@learn/02-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "post:01": "tsx 01-what-is-an-agent/example.ts",
    "post:02": "tsx 02-state-graphs/example.ts",
    "post:03": "tsx 03-agent-graph/example.ts",
    "post:04": "tsx 04-retries-and-recovery/example.ts",
    "post:05": "tsx 05-step-limits/example.ts",
    "post:06": "tsx 06-checkpoints-and-memory/example.ts",
    "post:07": "tsx 07-human-approval/example.ts start",
    "post:07:resume": "tsx 07-human-approval/example.ts resume --approve",
    "post:07:reject": "tsx 07-human-approval/example.ts resume --reject",
    "post:08": "tsx 08-multi-agent-handoffs/example.ts",
    "post:03:offline": "tsx 03-agent-graph/example.ts --offline",
    "post:06:offline": "tsx 06-checkpoints-and-memory/example.ts --offline",
    "post:07:offline": "tsx 07-human-approval/example.ts start --offline && tsx 07-human-approval/example.ts resume --approve --offline",
    "post:08:offline": "tsx 08-multi-agent-handoffs/example.ts --offline",
    "test:offline": "tsx 02-state-graphs/example.ts && tsx 03-agent-graph/example.ts --offline && tsx 04-retries-and-recovery/example.ts && tsx 05-step-limits/example.ts && tsx 06-checkpoints-and-memory/example.ts --offline && tsx 07-human-approval/example.ts start --offline && tsx 07-human-approval/example.ts resume --approve --offline && tsx 08-multi-agent-handoffs/example.ts --offline",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@langchain/langgraph": "1.5.2",
    "@langchain/core": "1.2.20",
    "@langchain/ollama": "1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "ai": "7.0.148",
    "zod": "4.6.7",
    "@learn/shared": "1.0.0"
  }
}
