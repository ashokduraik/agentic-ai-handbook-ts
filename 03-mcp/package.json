{
  "name": "@learn/03-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "post:01": "tsx 01-what-is-mcp/example.ts",
    "post:02": "tsx 02-tools/example.ts",
    "post:03": "tsx 03-resources/example.ts",
    "post:04": "tsx 04-prompts/example.ts",
    "post:05": "tsx 05-stdio-server/example.ts",
    "post:06": "tsx 06-agent-over-mcp/example.ts",
    "post:07": "tsx 07-http-and-auth/example.ts",
    "post:04:offline": "tsx 04-prompts/example.ts --offline",
    "post:06:offline": "tsx 06-agent-over-mcp/example.ts --offline",
    "post:07:serve": "tsx 07-http-and-auth/example.ts --serve",
